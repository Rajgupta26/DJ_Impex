# Enquiry email delivery (Resend). Without these the Server Action logs the
# payload in development and the form shows the WhatsApp fallback.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=ceo@djimpex.in
ENQUIRY_FROM_EMAIL=Nabeen website <enquiries@djimpex.in>

# Shows TBC tags, image placeholders and the /_todo checklist.
# true in development and staging previews, unset in production.
NEXT_PUBLIC_SHOW_TODO=true
